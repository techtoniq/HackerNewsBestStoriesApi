{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "StoryCache": {
    "AutomaticRefresh": true,
    "RefreshIntervalSeconds": 300,
    "CacheTtlSeconds": 300,
    "MaxStalenessSeconds": 1800,
    "MaxConcurrentRequests": 8,
    "MinimumSuccessRatio": 0.95,
    "FailureCooldownSeconds": 30,
    "RefreshTimeoutSeconds": 60,
    "OnDemandWaitSeconds": 10,
    "InitialLoadMaxRetryDelaySeconds": 30,
    "ClientCacheMaxAgeSeconds": 60
  },
  "DistributedCache": {
    "Provider": "Memory",
    "RedisConnectionString": "",
    "InstanceName": "BestStories:",
    "LockLeaseSeconds": 30,
    "LockWaitSeconds": 10,
    "LockPollMilliseconds": 200,
    "LocalCacheMilliseconds": 1000,
    "ReadTimeoutMilliseconds": 1000,
    "ReadFailureBackoffMilliseconds": 5000
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "AllowedHosts": "*"
}
