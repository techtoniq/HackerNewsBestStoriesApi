<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- <clear /> makes restores use only the sources below, whatever sources are configured on
       the machine, so a developer's private feeds cannot change what CI and the image resolve. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
